// secrets.h.example
//
// Template for SQM_pro/secrets.h (git-ignored, NEVER commit your real one!).
//
// HOW TO USE:
//   1. Copy this file to "secrets.h" in the same folder:
//        cp SQM_pro/secrets.h.example SQM_pro/secrets.h
//   2. Edit SQM_pro/secrets.h with your real credentials.
//   3. Re-flash the NodeMCU (USB or OTA).
//
// secrets.h is listed in .gitignore so your real credentials will never be
// pushed to GitHub by mistake. Future "git pull" calls will not overwrite it.
//
// You can override here ANY of the macros that Config.h declares with #ifndef
// fallbacks (currently: Wi-Fi credentials, sensor identity and OTA password).
//
#ifndef SECRETS_H
#define SECRETS_H

// -----------------------------------------------------------------------------
// Wi-Fi (primary)
// -----------------------------------------------------------------------------
#define WIFI_SSID      "YourPrimarySSID"
#define WIFI_PASSWORD  "YourPrimaryPassword"

// -----------------------------------------------------------------------------
// Wi-Fi (alternative / fallback) - used only if ALT_SSID_ON is defined
// -----------------------------------------------------------------------------
#define WIFI_SSID_ALT      "YourBackupSSID"
#define WIFI_PASSWORD_ALT  "YourBackupPassword"

// -----------------------------------------------------------------------------
// Sensor identity (SQM Nightwatch backend)
// -----------------------------------------------------------------------------
// Unique identifier for THIS device. Use a different one per physical sensor
// (SQM-001, SQM-002, ...). Same API key for all of them is fine.
#define SENSOR_ID    "SQM-001"

// API key generated from the "Configuration" tab of https://sqm.quentin-astro.fr
#define SENSOR_KEY   "paste-your-real-api-key-here"

// -----------------------------------------------------------------------------
// OTA (Over-The-Air firmware update)
// -----------------------------------------------------------------------------
// mDNS hostname advertised on the LAN. Make it unique per device so several
// SQM Pro can be flashed independently from Arduino IDE.
#define OTA_HOSTNAME  "sqm-pro-001"

// Password Arduino IDE will request before pushing a new firmware over OTA.
// CHANGE THIS to a strong, secret value!
#define OTA_PASSWORD  "change-me-please"

#endif // SECRETS_H
