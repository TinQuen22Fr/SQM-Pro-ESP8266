// secrets.h.example
//
// Template pour SQM_pro/secrets.h (git-ignored, NE JAMAIS commit le vrai !).
//
// COMMENT L'UTILISER (uniquement si vous compilez localement avec Arduino IDE) :
//   1. cp SQM_pro/secrets.h.example SQM_pro/secrets.h
//   2. Éditer SQM_pro/secrets.h avec vos vraies valeurs.
//   3. Flasher la NodeMCU (USB ou OTA).
//
// IMPORTANT - Depuis la v2.3.0 :
//   - WIFI_SSID / WIFI_PASSWORD NE SONT PLUS REQUIS. Les credentials WiFi sont
//     saisis par l'utilisateur via le portail captif `SQM-Setup-XXXXXX`
//     ouvert automatiquement au premier boot. Cf. WiFiPortal.ino.
//     → Pour forcer une reconfiguration sans accès au boîtier scellé :
//       DOUBLE RESET (couper/rallumer le courant 2 fois en moins de 5 s).
//
//   - SENSOR_ID n'est plus requis non plus. Le nom de la station est saisi
//     via le portail captif (champ "Nom de la station") et persisté en
//     EEPROM. Un nom par défaut `SQM-XXXXXX` (où XXXXXX = 6 derniers hex du
//     chip ID) est utilisé si l'utilisateur ne le personnalise pas.
//
// La CI GitHub Actions de ce repo génère automatiquement secrets.h à partir
// du secret de dépôt `SENSOR_KEY` au moment de la compilation. Le .bin
// publié dans les Releases est donc DÉJÀ pré-câblé pour pousser vers le
// serveur central du projet coopératif (sqm.quentin-astro.fr). Il suffit à
// un nouvel utilisateur de :
//   1. Flasher via /flasher sur sqm.quentin-astro.fr
//   2. Se connecter au WiFi `SQM-Setup-XXXXXX` apparu après le flash
//   3. Saisir SSID/password WiFi + nom de station dans le portail captif
//
#ifndef SECRETS_H
#define SECRETS_H

// -----------------------------------------------------------------------------
// Sensor identity (SQM Nightwatch backend)
// -----------------------------------------------------------------------------
// API key partagée par TOUS les capteurs du projet coopératif (= passe-partout
// vers le serveur central). À récupérer depuis l'onglet "Configuration ESP8266"
// de https://sqm.quentin-astro.fr (visible par l'admin du serveur).
//
// La CI injecte ce define automatiquement depuis le secret de dépôt
// `SENSOR_KEY`. Vous n'avez à le saisir ici QUE si vous compilez localement.
#define SENSOR_KEY   "paste-your-real-api-key-here"

// -----------------------------------------------------------------------------
// OTA (Over-The-Air firmware update) - optionnel
// -----------------------------------------------------------------------------
// Hostname mDNS annoncé sur le LAN. Doit être unique par sonde pour pouvoir
// pousser un nouveau firmware via Arduino IDE → Tools → Port → network port.
#define OTA_HOSTNAME  "sqm-pro-001"

// Mot de passe demandé par Arduino IDE avant un push OTA. À PERSONNALISER.
#define OTA_PASSWORD  "change-me-please"

#endif // SECRETS_H
